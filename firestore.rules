rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/myList/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/continueWatching/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/aiChat/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}